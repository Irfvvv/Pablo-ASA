{
  "name": "pablo-asa",
  "productName": "Pablo ASA",
  "version": "1.0.18",
  "description": "FOV, execs, autoclicker y comandos para ARK Survival Ascended. Auto-update como Pablo ARK App.",
  "main": "src/main.js",
  "author": "Pablo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Irfvvv/Pablo-ASA.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never && node scripts/write-update-json.js",
    "publish-update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-update.ps1"
  },
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pablo.asa",
    "productName": "Pablo ASA",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PabloASASetup.${ext}",
      "executableName": "PabloASA"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pablo ASA",
      "include": "pablo-custom.nsh"
    }
  }
}
